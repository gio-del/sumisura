{
  "manifest_version": 3,
  "name": "Sumisura \u2014 Job Capture",
  "version": "0.3.0",
  "description": "Capture the LinkedIn or Indeed job posting you're viewing into your local Sumisura app as a Job Listing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Capture this job into Sumisura",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "settings.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "job-capture@sumisura.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "turndown.js",
        "card-model.js",
        "card-view.js",
        "capture-common.js",
        "validate-capture.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.indeed.com/viewjob*"
      ],
      "js": [
        "turndown.js",
        "card-model.js",
        "card-view.js",
        "capture-common.js",
        "validate-capture.js",
        "content-indeed.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
